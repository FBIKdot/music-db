{
  "name": "music-db",
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --env-file --allow-read --allow-write --allow-net main.ts",
    "build": "deno compile --allow-read --allow-write --allow-net --engine quickjs --target x86_64-pc-windows-msvc -o dist/ main.ts",
    "preview": "./dist/music-db"
  },
  "exports": {
    ".": "./main.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/yaml": "jsr:@std/yaml@^1.0.10"
  },
  "fmt": {
    "exclude": [
      "./db.yaml"
    ]
  }
}
